# Use your existing Appwrite project, endpoint and a SERVER-ONLY key.
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_PROJECT_NAME="Noida.fit"
NEXT_PUBLIC_APPWRITE_ENDPOINT=
APPWRITE_KEY=

# Explicit resource IDs. For an existing deployment copy its real IDs, not new ones.
# For a fresh deployment choose IDs here before running npm run appwrite:setup.
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_COLLECTION_PROFILES=
NEXT_PUBLIC_APPWRITE_COLLECTION_FITNESS_IDS=
NEXT_PUBLIC_APPWRITE_COLLECTION_EVENTS=
NEXT_PUBLIC_APPWRITE_COLLECTION_RSVPS=
NEXT_PUBLIC_APPWRITE_COLLECTION_CHECKINS=
NEXT_PUBLIC_APPWRITE_COLLECTION_ACTIVITIES=
NEXT_PUBLIC_APPWRITE_COLLECTION_PLACES=
NEXT_PUBLIC_APPWRITE_COLLECTION_COMMUNITIES=
NEXT_PUBLIC_APPWRITE_COLLECTION_MEMBERSHIPS=
NEXT_PUBLIC_APPWRITE_COLLECTION_SAVED_ITEMS=
NEXT_PUBLIC_APPWRITE_COLLECTION_PARTICIPATIONS=

# Set this to the deployed origin. In local development leave unset.
# NEXT_PUBLIC_SITE_URL=https://noida.fit
# Setup creates a random signing secret in .env.local when not already provided.
# Signing/authentication secrets must NEVER have a NEXT_PUBLIC_ prefix.
# APPWRITE_CHECKIN_SECRET=
# Set true ONLY if your ingress overwrites, rather than appends, x-forwarded-for.
NEXT_PUBLIC_TRUST_PROXY_IP=false
# Browser integration tests require a running local server and create/clean test data.
# E2E_BASE_URL=http://localhost:3000
