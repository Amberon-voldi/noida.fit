{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noida-fit",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "NEXT_PUBLIC_APPWRITE_ENDPOINT": "https://sptaxibackend.com/v1",
    "NEXT_PUBLIC_APPWRITE_PROJECT_ID": "6abd3def003d664d4970",
    "NEXT_PUBLIC_APPWRITE_PROJECT_NAME": "Noida.fit",
    "NEXT_PUBLIC_APPWRITE_DATABASE_ID": "noida_fit",
    "NEXT_PUBLIC_APPWRITE_COLLECTION_PROFILES": "profiles",
    "NEXT_PUBLIC_APPWRITE_COLLECTION_FITNESS_IDS": "fitness_ids",
    "NEXT_PUBLIC_APPWRITE_COLLECTION_EVENTS": "events",
    "NEXT_PUBLIC_APPWRITE_COLLECTION_RSVPS": "event_rsvps",
    "NEXT_PUBLIC_APPWRITE_COLLECTION_CHECKINS": "event_checkins",
    "NEXT_PUBLIC_APPWRITE_COLLECTION_ACTIVITIES": "activities",
    "NEXT_PUBLIC_APPWRITE_COLLECTION_PLACES": "places",
    "NEXT_PUBLIC_APPWRITE_COLLECTION_COMMUNITIES": "communities",
    "NEXT_PUBLIC_APPWRITE_COLLECTION_MEMBERSHIPS": "community_memberships",
    "NEXT_PUBLIC_APPWRITE_COLLECTION_SAVED_ITEMS": "saved_items",
    "NEXT_PUBLIC_APPWRITE_COLLECTION_PARTICIPATIONS": "participations",
    "NEXT_PUBLIC_SITE_URL": "https://noida.fit"
  }
}
